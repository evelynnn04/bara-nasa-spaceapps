# NASA FIRMS map key (https://firms.modaps.eosdis.nasa.gov/api/map_key/). Only `python -m app download` uses it.
FIRMS_MAP_KEY=
# NASA Earthdata login token (https://urs.earthdata.nasa.gov > Generate Token). Only `python -m app context`
# uses it, for MODIS MCD12Q1 land cover and GPM IMERG rainfall. The token expires after 60 days.
EARTHDATA_TOKEN=
# Email alerts (docs/alerts.md). Off until ALERTS_SECRET is set: any long random string, which signs
# the confirm and unsubscribe links. Without SMTP_HOST the emails are written to data/alerts/outbox.
ALERTS_SECRET=
ALERTS_FROM=
PUBLIC_URL=http://localhost:5173
# SMTP server of the email provider, for example smtp.gmail.com, port 587, with a Gmail app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
