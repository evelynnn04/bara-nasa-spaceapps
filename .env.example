# NASA FIRMS map key (https://firms.modaps.eosdis.nasa.gov/api/map_key/). Only `python -m app download` uses it.
FIRMS_MAP_KEY=
# NASA Earthdata login token (https://urs.earthdata.nasa.gov > Generate Token). Only `python -m app context`
# uses it, for MODIS MCD12Q1 land cover and GPM IMERG rainfall. The token expires after 60 days.
EARTHDATA_TOKEN=
