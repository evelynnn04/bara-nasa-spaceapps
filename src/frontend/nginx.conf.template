server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json application/geo+json image/svg+xml;
    gzip_min_length 1000;

    # The API service, e.g. https://<api-service>.run.app (no trailing slash).
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The raw detections CSV streams for up to a few tens of seconds.
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # Built files carry a content hash in their name, so they never change.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Region outlines; nginx has no type for .geojson, and the type lets gzip apply.
    location ~ \.geojson$ {
        default_type application/geo+json;
        add_header Cache-Control "no-cache";
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
